generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String
  passwordHash            String
  emailVerifiedAt         DateTime?
  activeProviderConfigId  String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  analyses                ResumeAnalysis[]
  sessions                Session[]
  resumeDocuments         ResumeDocument[]
  analysisTasks           AnalysisTask[]
  providerProfiles        ProviderProfile[]
  providerConfigs         ProviderConfig[]         @relation("OwnedProviderConfigs")
  activeProviderConfig    ProviderConfig?          @relation("ActiveProviderConfig", fields: [activeProviderConfigId], references: [id], onDelete: SetNull)
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  interviewPrepSessions   InterviewPrepSession[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ResumeDocument {
  id               String           @id @default(cuid())
  userId           String
  createdAt        DateTime         @default(now())
  originalFileName String
  mimeType         String
  fileSize         Int
  storageKey       String
  extractedText    String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses         ResumeAnalysis[]
  analysisTasks    AnalysisTask[]

  @@index([userId, createdAt])
}

model AnalysisTask {
  id               String           @id @default(cuid())
  userId           String
  resumeDocumentId String?
  status           String           @default("queued")
  progressStage    String?
  progressMessage  String?
  streamedAnalysis String           @default("{}")
  attemptCount     Int              @default(0)
  processingToken  String?
  fileName         String?
  resumeText       String
  jobDescription   String
  provider         String
  model            String
  providerConfigEncrypted String?
  errorMessage     String?
  resultId         String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeDocument   ResumeDocument?  @relation(fields: [resumeDocumentId], references: [id], onDelete: SetNull)
  result           ResumeAnalysis?  @relation(fields: [resultId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model ProviderProfile {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  model           String
  configEncrypted String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId, updatedAt])
}

model ProviderConfig {
  id              String   @id @default(cuid())
  userId          String
  name            String
  provider        String
  model           String
  configEncrypted String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation("OwnedProviderConfigs", fields: [userId], references: [id], onDelete: Cascade)
  activeUsers     User[]   @relation("ActiveProviderConfig")

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

model ResumeAnalysis {
  id                 String                      @id @default(cuid())
  userId             String?
  resumeDocumentId   String?
  createdAt          DateTime                    @default(now())
  starred            Boolean                     @default(false)
  fileName           String?
  resumeText         String
  jobDescription     String
  score              Int?
  matchedKeywords    String                      @default("[]")
  missingKeywords    String                      @default("[]")
  suggestions        String                      @default("[]")
  rewrittenSummary   String                      @default("")
  rewrittenProjects  String                      @default("[]")
  interviewQuestions String                      @default("[]")
  user               User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  resumeDocument     ResumeDocument?             @relation(fields: [resumeDocumentId], references: [id], onDelete: SetNull)
  keywords           AnalysisKeyword[]
  suggestionItems    AnalysisSuggestion[]
  projectItems       AnalysisProject[]
  interviewItems     AnalysisInterviewQuestion[]
  sourceTask         AnalysisTask[]
  interviewPrepSession InterviewPrepSession?

  @@index([userId, createdAt])
  @@index([resumeDocumentId])
}

model InterviewPrepSession {
  id             String          @id @default(cuid())
  userId         String
  analysisId     String?         @unique
  sourceFileName String?
  resumeText     String
  jobDescription String
  questions      String          @default("[]")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis       ResumeAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AnalysisKeyword {
  id         String         @id @default(cuid())
  analysisId String
  kind       String
  value      String
  position   Int
  analysis   ResumeAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId, kind, position])
}

model AnalysisSuggestion {
  id         String         @id @default(cuid())
  analysisId String
  text       String
  position   Int
  analysis   ResumeAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId, position])
}

model AnalysisProject {
  id         String         @id @default(cuid())
  analysisId String
  title      String
  before     String
  after      String
  position   Int
  analysis   ResumeAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId, position])
}

model AnalysisInterviewQuestion {
  id         String         @id @default(cuid())
  analysisId String
  question   String
  answer     String
  position   Int
  analysis   ResumeAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId, position])
}
