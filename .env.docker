# ── 必填项 ────────────────────────────────────────────────────────────────────

# 应用访问地址（部署后的域名或 IP）
APP_ORIGIN="http://localhost:3000"

# 任务加密密钥（随机长字符串，勿泄露）
ANALYSIS_TASK_ENCRYPTION_KEY="change-me-to-a-long-random-string-32chars"

# ── AI 配置（至少配一个） ──────────────────────────────────────────────────────

AI_PROVIDER="openai"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# OpenRouter（可选）
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4.1-mini"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# ── 邮件配置 ──────────────────────────────────────────────────────────────────
# 开发/测试时使用 file 模式，邮件保存在 storage/email-outbox
EMAIL_DELIVERY_MODE="file"
EMAIL_FROM="no-reply@resume-optimizer.local"
EMAIL_OUTBOX_DIR="storage/email-outbox"

# 生产环境 SMTP 配置（EMAIL_DELIVERY_MODE=smtp 时生效）
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""

# ── Token 有效期 ───────────────────────────────────────────────────────────────
EMAIL_VERIFICATION_TOKEN_TTL_HOURS="24"
PASSWORD_RESET_TOKEN_TTL_MINUTES="30"
SESSION_DURATION_DAYS="30"
SESSION_REFRESH_THRESHOLD_HOURS="72"

# ── 任务队列 ──────────────────────────────────────────────────────────────────
ANALYSIS_TASK_TIMEOUT_MS="300000"
ANALYSIS_TASK_MAX_ATTEMPTS="3"
ANALYSIS_TASK_WORKER_CONCURRENCY="2"
ANALYSIS_QUEUE_NAME="analysis-tasks"
TASK_GUARD_SECRET=""

# ── 文件存储 ──────────────────────────────────────────────────────────────────
# 默认本地存储（挂载到 Docker volume）
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="storage"

# S3 兼容存储（可选）
# STORAGE_DRIVER="s3"
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_BUCKET="resume-optimizer"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="true"
# S3_PUBLIC_BASE_URL=""

# ── 以下由 docker-compose 自动注入，无需手动填写 ─────────────────────────────
# DATABASE_URL (auto: postgres container)
# REDIS_URL    (auto: redis container)
